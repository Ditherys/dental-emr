# Server-only environment identity. The project ID must match the URL below.
# Local development uses "development"; Vercel previews use "test".
APP_ENVIRONMENT=development
SUPABASE_PROJECT_ID=yourprojectref

# Public values used by ordinary browser and user-context server clients. A
# publishable key identifies the project but is not a user permission system;
# application authorization and RLS remain mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://yourprojectref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only application origin and controlled workforce invitation credential.
# The secret key bypasses RLS. Never prefix it with NEXT_PUBLIC_, expose it to a
# browser, assign a production value to Preview/Development, or commit it.
SUPABASE_SECRET_KEY=sb_secret_replace_me
APP_URL=http://localhost:3000
