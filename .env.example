# Public values used by ordinary browser and user-context server clients.
# Use the dedicated non-production Supabase project for local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only values used solely by the controlled workforce invitation path.
# Never prefix the secret key with NEXT_PUBLIC_ and never expose it to a browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me
APP_URL=http://localhost:3000
