{
  "name": "dental-emr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:responsive": "playwright test --grep @responsive",
    "e2e:provision": "node scripts/provision-e2e-identities.mjs",
    "test:db": "node scripts/run-remote-database-tests.mjs",
    "db:start:local": "node scripts/run-local-supabase-command.mjs start",
    "db:stop:local": "node scripts/run-local-supabase-command.mjs stop",
    "storage:start:local": "node scripts/run-local-minio.mjs start",
    "storage:stop:local": "node scripts/run-local-minio.mjs stop",
    "storage:status:local": "node scripts/run-local-minio.mjs status",
    "storage:smoke:local": "node --env-file-if-exists=.env.local scripts/run-local-storage-smoke.mjs",
    "db:reset:local": "node scripts/run-local-supabase-command.mjs reset",
    "db:provision:local": "node scripts/run-local-supabase-command.mjs provision-test-tooling",
    "test:db:local": "node scripts/run-local-database-tests.mjs",
    "test:db:cloud": "npm run test:db",
    "verify": "npm run security:migrations && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run security:secrets && npm run security:audit",
    "security:audit": "npm audit --audit-level=high",
    "security:auth": "node scripts/verify-hosted-auth-config.mjs",
    "security:migrations": "node scripts/run-migration-privilege-lint.mjs",
    "security:secrets": "secretlint \"**/*\"",
    "auth:bootstrap-owner": "node --env-file-if-exists=.env.local scripts/bootstrap-first-owner.mjs",
    "ci:test-target": "node scripts/validate-cloud-test-environment.mjs",
    "db:provision:test": "node scripts/run-guarded-supabase-command.mjs db-provision-test-tooling",
    "db:push:dry": "node scripts/run-guarded-supabase-command.mjs db-push-dry",
    "db:push:test": "node scripts/run-guarded-supabase-command.mjs db-push",
    "db:seed:test": "node scripts/run-guarded-supabase-command.mjs db-seed",
    "db:lint:test": "node scripts/run-guarded-supabase-command.mjs db-lint",
    "db:advisors:test": "node scripts/run-guarded-supabase-command.mjs db-advisors",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "db:types:check:test": "node scripts/generate-database-types.mjs --check --require-test-target"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@hookform/resolvers": "^5.7.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "secretlint": "13.0.4",
    "supabase": "2.113.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
